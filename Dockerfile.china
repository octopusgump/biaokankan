FROM node:22-alpine AS builder

WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm run build:china

FROM nginx:1.27-alpine
COPY deploy/china/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/china-dist /usr/share/nginx/html

EXPOSE 80
