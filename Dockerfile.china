FROM node:22-alpine AS builder

WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm run build:china

FROM nginx:1.27-alpine
COPY deploy/china/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/china/check-access-control.sh /docker-entrypoint.d/10-biaokankan-access-control.sh
COPY --from=builder /app/china-dist /var/www/biaokankan/current
RUN mkdir -p /etc/nginx/biaokankan && chmod 755 /docker-entrypoint.d/10-biaokankan-access-control.sh

EXPOSE 80 443
